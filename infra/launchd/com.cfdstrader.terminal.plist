<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plantilla (#863): install_autostart.sh reemplaza @ROOT@ y @PATH@ y la copia a ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cfdstrader.terminal</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>@ROOT@/infra/scripts/autostart_terminal.sh</string></array>
  <key>WorkingDirectory</key><string>@ROOT@</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>@PATH@</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>@ROOT@/logs/autostart_terminal.log</string>
  <key>StandardErrorPath</key><string>@ROOT@/logs/autostart_terminal.log</string>
</dict>
</plist>
