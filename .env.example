# Copiar a .env (que está en .gitignore) y completar. NUNCA commitear el .env real.
# Todos los valores de acá son FALSOS, de ejemplo.

# --- PostgreSQL (histórico) ---
POSTGRES_USER=cfds
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=cfdstrader
DATABASE_URL=postgres://cfds:cambiar-esto@127.0.0.1:5432/cfdstrader

# --- Redis (tiempo real, caché, eventos) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Broker IG (cuenta DEMO) ---
# Las usa engine/crates/ig (#66). La clave se genera en la web de IG.
# IG_API_KEY es opcional si el entorno la inyecta en el header X-IG-API-KEY (sesiones cloud).
# Solo DEMO: config/ig.toml rechaza cualquier otro entorno.
IG_ACCOUNT_TYPE=DEMO
IG_API_KEY=xxxxxxxxxxxxxxxx
IG_USERNAME=usuario-demo
IG_PASSWORD=xxxxxxxx

# --- Máquina que guarda los datos (#143) ---
# Solo en el .env del Mac mini (docs/guides/trabajo-en-paralelo.md). Sin esta marca, una carga
# de IG de más de loads.max_points_off_data_machine puntos (config/ig.toml) se niega.
# CFDS_DATA_MACHINE=1

# --- Tiingo, plan gratis (ADR 0009, #206) ---
# Solo para verificación transitoria: nada de Tiingo se guarda. Se usa solo con CFDS_DATA_MACHINE=1.
TIINGO_API_KEY=token-falso-de-ejemplo
